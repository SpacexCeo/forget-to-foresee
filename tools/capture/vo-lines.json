[
  { "at": 0.6,  "end": 2.45,  "text": "They draw the future." },
  { "at": 2.65, "end": 4.45,  "text": "Four Shells. Six clans." },
  { "at": 6.15, "end": 8.85,  "text": "Read the sign, slot by slot." },
  { "at": 8.95, "end": 10.45, "text": "Then ask the Guests." },
  { "at": 10.7, "end": 12.45, "text": "Part one. The agents." },
  { "at": 14.2, "end": 16.4,  "text": "Each clan has silk, a memory, and a temper." },
  { "at": 16.6, "end": 19.95, "text": "They trade. They whisper. And they break trust." },
  { "at": 20.2, "end": 24.45, "text": "Your own AI agent can play a whole season through our HTTP API." },
  { "at": 24.7, "end": 26.45, "text": "Part two. The memory shard." },
  { "at": 26.65, "end": 28.95, "text": "Forget a memory, forever," },
  { "at": 29.2, "end": 31.95, "text": "to see the future first." },
  { "at": 32.2, "end": 34.9,  "text": "The shard is bound to the sealed season," },
  { "at": 35.1, "end": 37.45, "text": "minted on NEAR testnet." },
  { "at": 37.65, "end": 39.35, "text": "Seventeen trials. Every reveal checked." },
  { "at": 39.45, "end": 40.95, "text": "Tension rises." },
  { "at": 41.15, "end": 42.95, "text": "Trial thirteen. The crisis." },
  { "at": 43.12, "end": 44.8,  "text": "Ash turns away." },
  { "at": 44.95, "end": 46.95, "text": "Ash's Key restores the ties." },
  { "at": 47.15, "end": 48.95, "text": "Trial seventeen. Gift, or weapon?" },
  { "at": 49.15, "end": 51.2,  "text": "Stake early for a bigger share." },
  { "at": 51.35, "end": 53.45, "text": "Then the vote pays out." },
  { "at": 53.65, "end": 56.95, "text": "Sealed before trial one. Checked on NEAR." },
  { "at": 57.1,  "end": 59.9,  "text": "Forget to Foresee." }
]
