node_modules/
dist/
.vite/
*.log
.env
.env.*
!.env.example
.DS_Store
Thumbs.db

# Blender auto-backups
*.blend1

# Procedural art build products: regenerated by the scripts in art/; the
# textures ship embedded in the .glb files
art/*/textures/
art/*/*.blend
# Agent costume build intermediates (textures are embedded in the glbs)
art/agents/textures/
__pycache__/

# Local agent worktrees and session data
.claude/

# Dev-only scratch (reference images for HUD comparison, screenshots)
game/.scratch/
# capture: per-machine GPU flags found by tools/capture/gpu-probe.mjs
tools/capture/.gpu-args.json

# near.social post payloads (generated by tools/near-social/post.py)
tools/near-social/out/
